# Modèle pour signer l'AAB envoyé au Play Store. Copier en keystore.properties (ignoré par Git),
# à la racine du dépôt, et garder la clé et ses mots de passe hors du dépôt.
# Créer la clé d'envoi une seule fois, sur sa machine :
#   keytool -genkeypair -v -keystore ~/cles/sonorama-upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
storeFile=/chemin/vers/sonorama-upload.jks
storePassword=
keyAlias=upload
keyPassword=
